{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:tencent": "DEPLOY_TARGET=tencent vinext build",
    "test": "node --experimental-strip-types --test tests/creature.test.ts tests/recording-batch.test.mjs tests/depth-bridge.test.ts tests/depth-input.test.ts tests/creature-archive.test.ts tests/sound-state.test.ts tests/visual-stage.test.ts tests/trust-copy.test.ts tests/shared-shaping.test.ts tests/gifts.test.ts tests/gifts-cloudbase.test.ts tests/gifts-transport.test.ts",
    "qa:lighting": "node scripts/lighting-browser-qa.mjs",
    "spec:validate": "openspec validate --all --strict",
    "setup:assets": "node scripts/setup-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build:gifts": "VITE_GIFTS_ONLINE=true vite build --config prototypes/live-gift/vite.config.mts --outDir ../../outputs/gifts/site",
    "start:gifts": "node services/gifts/start.ts",
    "build:gifts:cloud": "node scripts/build-gifts-cloudbase.mjs",
    "build:gifts:sdk": "VITE_GIFTS_ONLINE=true VITE_GIFTS_TRANSPORT=cloudbase vite build --config prototypes/live-gift/vite.config.mts --outDir ../../outputs/gifts/sdk-site"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@cloudbase/js-sdk": "3.10.1",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@fission-ai/openspec": "1.13.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.27.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
